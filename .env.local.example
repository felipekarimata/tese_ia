# Next.js App URL (for internal API calls)
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Supabase - Persistência do banco de dados
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-key-aqui
# Service role key (SOMENTE servidor) - usada pela auth e pelo painel admin
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth.js - Obrigatório para autenticação
AUTH_SECRET=seu-secret-seguro-aqui-troque-em-producao
# URL pública usada para montar links de email (reset de senha). Em prod, a URL do app.
NEXTAUTH_URL=http://localhost:3000

# SMTP (Brevo) - envio de email de redefinição/definição de senha.
# Se SMTP_HOST ficar vazio, o link é apenas logado no console (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AutorIA <no-reply@seudominio.com>

# Login Microsoft 365 (Entra ID) - deixe vazio para desabilitar o botão.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=8719cdb6-fc6e-4a12-9aff-4657dbbc50af

# Keep-alive do Supabase (opcional). Se definido, /api/cron/keepalive exige
# Authorization: Bearer <valor> ou ?secret=<valor>.
CRON_SECRET=

# Opcional - chaves de IA podem ser configuradas via UI em /settings
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
